# Admin login: user "admin" + this password (8+ characters)
ADMIN_PASSWORD=change-me-please

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Database name (created automatically on first post)
MONGODB_DB=heritage_blog

# Photo uploads (ImageKit → Developer options → Private key)
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxx
IMAGEKIT_FOLDER=/HeritageCrops/blogs
 